# Environnement d'exécution et base de données (serveur uniquement sauf NEXT_PUBLIC_*)
NODE_ENV=
APP_ENV=
DATABASE_URL=
DATABASE_SSL=

# Identité publique de l'application (exposée au navigateur)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_NAME=

# Supabase Auth (strictement côté serveur, aucune clé NEXT_PUBLIC_SUPABASE_*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting distribué côté serveur)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-mails transactionnels et alertes de sécurité (Resend)
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Sel cryptographique pour le hachage irréversible des IP et identifiants (min 32 caractères)
IP_HASH_SECRET=

# Secret partagé des tâches planifiées /api/cron/* (min 32 caractères)
CRON_SECRET=

# Fournisseur sportif BONUVO AI (Phase 7, serveur uniquement)
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=
AI_LLM_ENABLED=false
GEMINI_API_KEY=

# Canaux communautaires & Bot Telegram optionnel (Phase 8, serveur uniquement)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Secrets partenaires d'affiliation S2S (référencés dynamiquement par secret_env_ref en base, préfixe AFFILIATE_)
AFFILIATE_1XPARTNERS_SECRET=
AFFILIATE_1WIN_SECRET=
